---
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;

const ringBase =
	"shadow-[inset_0_0_0_3px_var(--color-apricot-cream)] hover:shadow-[inset_0_0_0_3px_var(--color-sky-surge)]";
---

<a
	class:list={[
		"block w-full shrink-0 rounded-full bg-sky-surge px-[clamp(1rem,4vw,1.5rem)] py-[clamp(0.5rem,1.8dvh,0.75rem)] text-center font-display text-[clamp(0.875rem,3.5vw,1rem)] font-black uppercase tracking-wide text-white text-shadow-brand transition-[color,background-color,text-shadow,box-shadow] duration-200 hover:bg-apricot-cream hover:text-baltic-blue hover:text-shadow-brand-invert focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-icy-aqua",
		ringBase,
	]}
	href={href}
	target="_blank"
	rel="noopener noreferrer"
>
	{label}
</a>
