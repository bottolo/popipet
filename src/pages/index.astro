---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LinkButton from "../components/LinkButton.astro";
import BioCard from "../components/BioCard.astro";
import DotDivider from "../components/DotDivider.astro";

const links = [
	{ label: "IG", href: "https://www.instagram.com/sophy.ret/" },
	{ label: "TWT", href: "https://x.com/Sophyret" },
	{ label: "KO-FI", href: "https://ko-fi.com/sophyret/shop" },
	{ label: "ART.FIG", href: "https://artfight.net/login" },
	{ label: "SHOP", href: "https://sophyret.sumupstore.com/" },
	{ label: "VGEN", href: "https://vgen.co/Sophyret" },
];
---

<Layout>
	<div class="relative flex h-dvh max-h-dvh flex-col overflow-hidden">
		<Header />

		<div class="flex min-h-0 flex-1">
			<div
				class="hidden shrink-0 md:block md:w-[clamp(8rem,24vw,24rem)]"
				aria-hidden="true"
			>
			</div>

			<div
				class="flex min-h-0 min-w-0 flex-1 flex-col items-center justify-start overflow-hidden pt-[clamp(0.5rem,2dvh,1.25rem)]"
			>
				<div
					class="flex w-[85vw] max-w-[48rem] flex-col items-center gap-[clamp(0.375rem,1.5dvh,1rem)] md:w-full md:max-w-[min(100%,48rem)] md:px-[clamp(0.5rem,2vw,1rem)]"
				>
					<h1
						class="shrink-0 text-center font-display text-[clamp(1.75rem,9vw,3.5rem)] font-black uppercase leading-none tracking-wide"
					>
						<span
							class="inline-block rounded-full bg-sky-surge border-3 border-apricot-cream px-[clamp(1rem,5vw,2rem)] py-[clamp(0.25rem,1dvh,0.5rem)] text-white text-shadow-brand"
						>
							SOPHYRET
						</span>
					</h1>

					<main
						class="flex w-full min-h-0 flex-col items-center gap-[clamp(0.375rem,1.5dvh,1rem)] md:flex-row md:items-stretch md:gap-4"
					>
						<nav
							class="flex w-full flex-col gap-[clamp(0.25rem,1dvh,0.5rem)] md:w-[clamp(12rem,28vw,16rem)] md:shrink-0"
							aria-label="Social and shop links"
						>
							{
								links.map((link) => (
									<LinkButton
										href={link.href}
										label={link.label}
									/>
								))
							}
						</nav>

						<DotDivider orientation="horizontal" />
						<DotDivider orientation="vertical" />

						<BioCard />
					</main>
				</div>
			</div>

			<div
				class="hidden shrink-0 md:block md:w-[clamp(8rem,24vw,24rem)]"
				aria-hidden="true"
			>
			</div>
		</div>

		<Footer />

		<img
			src="/oc.webp"
			alt=""
			class="pointer-events-none absolute bottom-0 right-0 z-20 max-h-[min(42dvh,380px)] w-auto max-w-[min(72vw,420px)] object-contain object-bottom md:max-h-[min(50dvh,520px)] md:max-w-[min(48vw,560px)]"
		/>
	</div>
</Layout>
